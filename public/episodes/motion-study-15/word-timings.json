  "id": "motion-study-15",
  "script": {
    "title": "MotionStudy · Saniyeler",
    "hook": "On iki gün mü, otuz iki yıl mı?",
    "narrationStartFrame": 0,
    "resultHoldFrames": 36,
    "phrases": [
      {
        "spoken": "Üç sıfır, geçen zamanı ne kadar değiştirir?",
        "display": [
          "Üç sıfır, geçen zamanı",
          "ne kadar değiştirir?"
        ]
      },
      {
        "spoken": "Bir milyon saniye,",
        "display": [
          "1 milyon saniye,"
        ]
      },
      {
        "spoken": "yaklaşık on bir virgül altı gün.",
        "display": [
          "yaklaşık 11,6 gün."
        ]
      },
      {
        "spoken": "Bir milyar saniye?",
        "display": [
          "1 milyar saniye?"
        ]
      },
      {
        "spoken": "Otuz bir virgül yedi yıl.",
        "display": [
          "31,7 yıl."
        ]
      },
      {
        "spoken": "Aynı süreden tam bin tane.",
        "display": [
          "Aynı süreden tam 1.000 tane."
        ]
      }
    ],
